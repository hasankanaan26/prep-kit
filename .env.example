# Prep-kit practice keys. Copy this file to .env (in this prep-kit folder) and fill in
# whichever you have. All three are free. This file is NOT the course .env:
# the course key goes in deskhand-workshop/.env (module 08).
#
# .env is gitignored. Never commit it, paste it in chat, or put a key in a screenshot.

# --- Gemini (Google AI Studio, free tier) ---- module 04
# Get a key: https://aistudio.google.com/apikey
# Free tier: Google may use what you send to improve its products. Don't send personal data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenRouter (one key, hundreds of models) ---- module 04
# Get a key: https://openrouter.ai/settings/keys
# "openrouter/free" picks a free model for you. About 50 free requests a day without credit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- Ollama (runs on your laptop, no key, works offline) ---- module 05
# Install: https://ollama.com/download   then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1
